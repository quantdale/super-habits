# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
.playwright-mcp

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# Playwright MCP + Lighthouse audit output (dev tooling only)
.cursor/playwright-output/*
!.cursor/playwright-output/.gitkeep

# Playwright E2E
/playwright-report/
/test-results/

# generated native folders
/ios
/android

.vercel
.env*.local

# Supabase CLI local state (contains project ref / pooler URL)
supabase/.temp/

# Simulation platform: run reports, screenshots, digests, repro bundles and
# the compiled runner output are all derived artifacts — never committed.
/simulation-output/
/simulation/.build/

# Repro bundles (task 5) live under the gitignored simulation-output by default;
# this explicit entry guards any tooling that captures to a custom root.
/simulation-output/bundles/

# Disposable-backend lane (task 8.4): the `dist-live/` export is produced only
# inside the guarded disposable job and must never be committed; state/ holds
# the short-lived disposable env + marker (contains an anon key).
/dist-live/
/simulation/backend/state/

# Parent task 6.1a: the `dist-sync/` export (dummy Supabase env) is produced on
# main/nightly CI and by the documented local command — never committed.
/dist-sync/

# Editor debug traces
.cursor/debug-*.log
