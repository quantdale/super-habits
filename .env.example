# Supabase (optional; app runs local-only if unset)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Command parser (optional real-parser path)
# Values must be ones features/command/commandConfig.ts actually accepts:
# parse mode is `mock` (default) or `remote_with_fallback`; backend host is
# `supabase_edge` (default, needs Supabase url + anon key) or `custom_url`
# (needs EXPO_PUBLIC_AI_COMMAND_PROXY_URL).
EXPO_PUBLIC_AI_COMMAND_PARSE_MODE=mock
EXPO_PUBLIC_AI_COMMAND_INTERNAL_ROLLOUT=false
EXPO_PUBLIC_AI_COMMAND_BACKEND_HOST=supabase_edge
EXPO_PUBLIC_AI_COMMAND_SUPABASE_FUNCTION_NAME=parse-ai-command
EXPO_PUBLIC_AI_COMMAND_PROXY_URL=

# Command Center Ask/Auto surfaces (optional; default OFF)
# `true` is an internal build/distribution opt-in that reveals Ask/Auto;
# anything else (including unset) keeps them hidden.
EXPO_PUBLIC_AI_ASK_INTERNAL_ROLLOUT=false

# E2E feature gates
E2E_COMMAND_INTERNAL_OBSERVATION=false
E2E_COMMAND_INTERNAL_EVAL=false
